#!/bin/bash
# Mac 清理助手 · 启动器（.app 双击入口）
#
# 关键设计：**启动器自己不常驻**。
# 本应用没有窗口，界面在浏览器里。如果启动器一直挂着，macOS 认为「这个 App 已经在运行」，
# 之后再点图标只会去「激活」那个没有窗口的进程 —— 用户看到的就是「点了没反应」。
# 所以：把服务放到后台跑，启动器立刻退出；每次点击都会重新走一遍启动器，
# 于是每次点击都能把界面（浏览器）带出来。
set -uo pipefail

RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
STATE="$HOME/.local/state/mac-cleanup-app"
LOG="$STATE/launch.log"
mkdir -p "$STATE"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null; }

die() {
  log "启动失败: $*"
  osascript -e "display alert \"Mac 清理助手无法启动\" message \"$*\" as critical" >/dev/null 2>&1
  exit 1
}

open_ui() {
  local url="$1"
  if open "$url" >>"$LOG" 2>&1; then log "已打开界面: $url"; return 0; fi
  if open -a Safari "$url" >>"$LOG" 2>&1; then log "已用 Safari 打开: $url"; return 0; fi
  log "自动打开浏览器失败: $url"
  osascript -e "display dialog \"服务已启动，但没能自动打开浏览器。\n\n请手动打开这个地址：\n$url\n\n（已复制到剪贴板）\" buttons {\"好\"} default button 1" \
            -e "set the clipboard to \"$url\"" >/dev/null 2>&1
  return 0
}

log "--- 启动 ($0)"

# 1) 已在运行 → 直接把界面带出来
if [ -f "$STATE/port" ]; then
  PORT="$(cat "$STATE/port" 2>/dev/null || true)"
  if [ -n "${PORT:-}" ] && curl -s -m 2 "http://127.0.0.1:$PORT/api/state" >/dev/null 2>&1; then
    log "复用已在运行的服务: $PORT"
    open_ui "http://127.0.0.1:$PORT/"
    exit 0
  fi
  log "端口文件里的服务(${PORT:-空})没有响应，重新启动"
fi

# 2) 清掉残留的旧服务（上次没退干净会出现两个进程抢端口）
if pkill -f "$RES/server.py" 2>/dev/null; then
  log "清理了残留服务进程"
  sleep 0.4
fi

# 3) 选 python（技能脚本只用标准库，3.9+ 即可）
PY=""
for c in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 \
         "$HOME/.local/bin/python3.11"; do
  [ -x "$c" ] && { PY="$c"; break; }
done
for c in "$HOME"/.hermes/tools/python-*/bin/python3; do
  [ -n "$PY" ] && break
  [ -x "$c" ] && PY="$c"
done
[ -n "$PY" ] || die "找不到 python3。\n\n请先在终端里执行一次：\nxcode-select --install"
log "使用 python: $PY"

"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >>"$LOG" 2>&1 \
  || die "python3 版本过低（需要 3.9+）：$PY"

# 4) 技能脚本目录：优先实时技能（跟着技能更新走），否则用 app 自带副本
if [ -z "${MAC_CLEAN_SKILL:-}" ]; then
  if [ -f "$HOME/.hermes/skills/devops/macos-deep-optimize/scripts/scan.py" ]; then
    export MAC_CLEAN_SKILL="$HOME/.hermes/skills/devops/macos-deep-optimize/scripts"
  else
    export MAC_CLEAN_SKILL="$RES/skill-scripts"
  fi
fi
log "技能目录: $MAC_CLEAN_SKILL"

# 5) 后台起服务（自己不开浏览器，由本脚本负责打开，避免两次打开）
export MAC_CLEAN_OPEN=0
nohup "$PY" "$RES/server.py" >>"$LOG" 2>&1 &
SRV=$!
log "server.py 已后台启动 (pid=$SRV)"

# 6) 等端口文件出现（最多 8 秒），然后打开界面
for _ in $(seq 1 80); do
  PORT="$(cat "$STATE/port" 2>/dev/null || true)"
  if [ -n "${PORT:-}" ] && curl -s -m 1 "http://127.0.0.1:$PORT/api/state" >/dev/null 2>&1; then
    open_ui "http://127.0.0.1:$PORT/"
    exit 0
  fi
  sleep 0.1
done

die "服务启动超时（8 秒）。\n\n详情见：\n$LOG\n$STATE/server.log"
